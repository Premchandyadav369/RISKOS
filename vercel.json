{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/risk/:path*",
      "destination": "https://riskos-backend.onrender.com/api/risk/:path*"
    },
    {
      "source": "/api/signals/:path*",
      "destination": "https://riskos-backend.onrender.com/api/signals/:path*"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/terminal",
      "destination": "/app.html"
    }
  ]
}
