# =====================================================================
# RISKOS Quantitative Platform - Environment Configuration Template
# =====================================================================
# Copy this file to .env and adjust values for local or staging deployment.
# NEVER commit .env files with production secrets to version control.

# --- SERVER CONFIGURATION ---
RISKOS_HOST=127.0.0.1
RISKOS_PORT=8000
RISKOS_ENV=development # development | staging | production
RISKOS_LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR

# --- SECURITY & ACCESS CONTROL ---
# Comma-separated list of allowed origins. Use * only in development.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5500
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_HEAVY_ENDPOINTS_PER_MINUTE=30
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# --- MARKET DATA PROVIDERS (OPTIONAL) ---
# When omitted or rate-limited, RISKOS transparently falls back to high-fidelity synthetic bridges.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=
YFINANCE_CACHE_TTL_SECONDS=300

# --- QUANTITATIVE ENGINE DEFAULTS ---
DEFAULT_RISK_FREE_RATE=0.065 # 6.5% INR benchmark proxy
DEFAULT_BASE_CAPITAL=10000000 # 10,000,000 INR (1 Crore)
DEFAULT_CONFIDENCE_LEVEL=0.99 # 99% VaR/CVaR
MAX_PORTFOLIO_CONSTITUENTS=100
MONTE_CARLO_MAX_SIMS=50000

# --- AUDIT & TELEMETRY ---
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=logs/audit.log
STRUCTURED_LOGGING_JSON=true
