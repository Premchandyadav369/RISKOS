# ==============================================================================
# RISKOS Production Environment Variables Configuration Template
# Copy this file to '.env' and fill in your private tokens:
#   cp .env.example .env
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Telegram 24/7 Mobile Push Alerts (Takes 2 minutes to create free)
# 1. Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram (send /newbot)
# 2. Get TELEGRAM_CHAT_ID from @userinfobot or @GetMyIdBot on Telegram
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Discord Webhook Alerts (Optional Alternative)
# Create in Discord: Channel Settings -> Integrations -> Webhooks -> Copy Webhook URL
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
